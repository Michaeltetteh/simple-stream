<div class="w-full">
  <h1 class="text-2xl font-black text-white text-center mb-1">Create an account</h1>
  <p class="text-sm text-gray-500 text-center mb-8">
    Set up your admin access
  </p>

  <%= if @changeset.action == :insert do %>
    <div class="mb-4 rounded-lg bg-red-500/10 border border-red-500/30 px-4 py-3 text-sm text-red-400">
      Please fix the errors below.
    </div>
  <% end %>

  <form action={~p"/admin/users/register"} method="post" class="space-y-4">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

    <div>
      <label for="user_email" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Email</label>
      <input
        type="email"
        name="user[email]"
        id="user_email"
        value={Ecto.Changeset.get_field(@changeset, :email) || ""}
        required
        autofocus
        class="w-full bg-gray-800 border border-gray-700 text-white placeholder-gray-600 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 transition-colors"
        placeholder="you@example.com"
      />
      <%= for error <- Keyword.get_values(@changeset.errors, :email) do %>
        <p class="text-red-400 text-xs mt-1"><%= translate_error(error) %></p>
      <% end %>
    </div>

    <div>
      <label for="user_password" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Password</label>
      <input
        type="password"
        name="user[password]"
        id="user_password"
        required
        class="w-full bg-gray-800 border border-gray-700 text-white placeholder-gray-600 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 transition-colors"
        placeholder="Min. 12 characters"
      />
      <%= for error <- Keyword.get_values(@changeset.errors, :password) do %>
        <p class="text-red-400 text-xs mt-1"><%= translate_error(error) %></p>
      <% end %>
    </div>

    <button
      type="submit"
      class="w-full bg-accent hover:bg-red-700 text-white font-bold text-sm py-3 rounded-lg transition-colors mt-2"
    >
      Create account
    </button>
  </form>

  <p class="text-center text-sm text-gray-600 mt-6">
    Already have an account?
    <a href={~p"/admin/users/log_in"} class="text-gray-400 hover:text-white transition-colors font-medium">Sign in</a>
  </p>
</div>
