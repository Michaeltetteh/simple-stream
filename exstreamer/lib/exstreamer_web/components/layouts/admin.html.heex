<%!-- Admin layout: dark sidebar + top bar --%>
<div class="flex min-h-screen bg-gray-950 text-white">
  <%!-- Sidebar --%>
  <aside class="admin-sidebar w-56 flex-shrink-0 bg-gray-925 border-r border-gray-800 flex flex-col">
    <div class="px-6 py-5 border-b border-gray-800">
      <a href={~p"/"} class="text-accent font-black text-xl tracking-tight">EXSTREAMER</a>
      <p class="text-xs text-gray-500 mt-0.5">Admin Panel</p>
    </div>

    <nav class="flex-1 px-3 py-4 space-y-1 text-sm font-medium">
      <a href={~p"/admin/dashboard"}
         class={"flex items-center gap-3 px-3 py-2 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition-colors #{if String.starts_with?(assigns[:request_path] || "", "/admin/dashboard"), do: "active"}"}>
        <.icon name="hero-squares-2x2-mini" class="w-4 h-4"/> Dashboard
      </a>
      <a href={~p"/admin/movies"}
         class={"flex items-center gap-3 px-3 py-2 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition-colors #{if String.starts_with?(assigns[:request_path] || "", "/admin/movies"), do: "active"}"}>
        <.icon name="hero-film-mini" class="w-4 h-4"/> Movies
      </a>
      <a href={~p"/admin/series"}
         class={"flex items-center gap-3 px-3 py-2 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition-colors #{if String.starts_with?(assigns[:request_path] || "", "/admin/series"), do: "active"}"}>
        <.icon name="hero-tv-mini" class="w-4 h-4"/> TV Series
      </a>
      <a href={~p"/admin/categories"}
         class={"flex items-center gap-3 px-3 py-2 rounded-lg text-gray-300 hover:bg-gray-800 hover:text-white transition-colors #{if String.starts_with?(assigns[:request_path] || "", "/admin/categories"), do: "active"}"}>
        <.icon name="hero-tag-mini" class="w-4 h-4"/> Categories
      </a>
    </nav>

    <div class="px-3 py-4 border-t border-gray-800 text-xs text-gray-500 space-y-2">
      <a href={~p"/admin/users/settings"} class="flex items-center gap-2 px-3 py-2 hover:text-gray-300 transition-colors">
        <.icon name="hero-cog-6-tooth-mini" class="w-4 h-4"/> Settings
      </a>
      <.link href={~p"/admin/users/log_out"} method="delete"
             class="flex items-center gap-2 px-3 py-2 hover:text-gray-300 transition-colors w-full">
        <.icon name="hero-arrow-left-on-rectangle-mini" class="w-4 h-4"/> Log out
      </.link>
    </div>
  </aside>

  <%!-- Main content --%>
  <div class="flex-1 flex flex-col overflow-hidden">
    <header class="h-14 border-b border-gray-800 flex items-center justify-between px-6 bg-gray-950">
      <h1 class="text-sm font-semibold text-gray-200">
        <%= assigns[:page_title] || "Admin" %>
      </h1>
      <span class="text-xs text-gray-500"><%= @current_user && @current_user.email %></span>
    </header>

    <main class="flex-1 overflow-y-auto p-6">
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </main>
  </div>
</div>
