<%!-- Streaming layout: dark navbar + flash group --%>
<nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-3 bg-gradient-to-b from-black/90 to-transparent">
  <div class="flex items-center gap-8">
    <a href={~p"/"} class="text-accent font-black text-2xl tracking-tight select-none">
      EXSTREAMER
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-300">
      <a href={~p"/movies"} class="hover:text-white transition-colors">Movies</a>
      <a href={~p"/series"} class="hover:text-white transition-colors">Series</a>
    </div>
  </div>

  <div class="flex items-center gap-4">
    <a href={~p"/search"} class="text-gray-300 hover:text-white transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
      </svg>
    </a>

    <%= if @current_user do %>
      <a href={~p"/admin/dashboard"} class="text-sm text-gray-300 hover:text-white transition-colors font-medium">
        Admin
      </a>
    <% else %>
      <a href={~p"/admin/users/log_in"} class="text-sm text-gray-300 hover:text-white transition-colors font-medium">
        Admin
      </a>
    <% end %>
  </div>
</nav>

<main class="min-h-screen bg-gray-900 text-white pt-14">
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>
